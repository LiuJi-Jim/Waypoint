<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Waypoint"
             x:Class="Waypoint.EditionSwitch">
  <UserControl.Styles>
    <StyleInclude Source="avares://Waypoint/Views/ViewStyles.axaml" />
  </UserControl.Styles>
  <!-- Simple mode's Release | Latest switch (Editions): which LocalExile Play runs. -->
  <StackPanel HorizontalAlignment="Center" Margin="0,0,0,28">
    <StackPanel Orientation="Horizontal" Spacing="16" HorizontalAlignment="Center">
      <RadioButton x:Name="ReleaseChoice" GroupName="Edition" Content="{l:Loc 'Release'}" Click="Chosen"
                   ToolTip.Tip="{l:Loc 'LocalExile as released: tested, and updated when you accept.'}" />
      <RadioButton x:Name="LatestChoice" GroupName="Edition" Content="{l:Loc 'Latest'}" Click="Chosen"
                   ToolTip.Tip="{l:Loc 'LocalExile as it is being made: the newest changes, updated when you play.'}" />
    </StackPanel>
    <TextBlock x:Name="Caption" Classes="note" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0" />
  </StackPanel>
</UserControl>
