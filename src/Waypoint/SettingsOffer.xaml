<UserControl x:Class="Waypoint.SettingsOffer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Waypoint"
             Visibility="Collapsed">
    <!-- Play's one offer to a setup from before Waypoint gave LocalExile game settings of its own. -->
    <Border Margin="0,18,0,0" Padding="14,10" CornerRadius="6" BorderThickness="1"
            Background="{DynamicResource Shell.Panel}" BorderBrush="{DynamicResource Shell.Border}">
        <StackPanel>
            <TextBlock x:Name="OfferText" TextAlignment="Center" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                <Button Content="{l:Loc 'Use separate settings'}" Click="UseClicked" Margin="0,0,8,0" />
                <Button Content="{l:Loc 'Not now'}" Click="DeclineClicked" Margin="0" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
